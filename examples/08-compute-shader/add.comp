#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in; // 워크그룹 크기 : 64개씩 묶어서 실행

layout(set = 0, binding = 0, std430) readonly buffer InputA // 입출력 버퍼 선언
{
    float values[];
} inputA;

layout(set = 0, binding = 1, std430) readonly buffer InputB
{
    float values[];
} inputB;

layout(set = 0, binding = 2, std430) writeonly buffer Output
{
    float values[];
} resultBuffer;

layout(push_constant) uniform Parameters
{
    uint count;
} params;

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= params.count)
    {
        return;
    }
    resultBuffer.values[index] = inputA.values[index] + inputB.values[index];
}
